# Symlinked to ~/.zshrc from ~/.dotfiles/zsh/zshrc
#
# Portable config only. Anything with an absolute path, a Homebrew prefix, or an
# SDK that isn't on every machine belongs in ~/.zshrc.local, which is untracked
# and sourced at the bottom of this file.

export DOTFILES="$HOME/.dotfiles"
export EDITOR="nvim"
export PATH="$HOME/.local/bin:$PATH"

# --- oh-my-zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# --- machine-specific: SDKs, absolute paths, tool-managed blocks ---
# Sourced last so it can override anything above. Kept out of the repo because
# `conda init` and Rancher Desktop rewrite their own blocks in place, and
# ~/.zshrc is a symlink into ~/.dotfiles.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
